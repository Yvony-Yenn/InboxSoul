# Local LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Cloud LLM (optional, used by Hermes Stage 2 meta-rewriter or as fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage
CHROMA_PATH=./.chroma
SQLITE_PATH=./inboxsoul.db

# Email source (choose one)
EMAIL_PROVIDER=imap          # imap | gmail | local
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Gmail OAuth (if EMAIL_PROVIDER=gmail)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Hermes
HERMES_FEWSHOT_TOP_K=3
HERMES_PROMPT_REWRITE_CRON=0 3 * * 0   # weekly, Sunday 3am